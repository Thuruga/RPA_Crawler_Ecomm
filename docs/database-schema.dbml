// PostgreSQL - modelo recomendado para a aplicacao atual.
// IDs: bigint identity. Valores monetarios: numeric(12,2).
// Fora do PostgreSQL: regras MAP, ruptura agregada e shipping_quotes (Redis).
// GIN, BRIN e particionamento devem ser adicionados apenas com volume/query medidos.

Table brands {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  brand_key varchar(63) [not null, unique]
  brand_name varchar(160) [not null]
  domain text [not null, unique]
  engine varchar(63)
  configuration jsonb [not null, default: '{}', note: 'Configuracao completa da engine; deve ser um objeto']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table brand_category_mappings {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  brand_id bigint [not null]
  canonical_slug varchar(160) [not null]
  source_path text
  label varchar(200)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (brand_id, canonical_slug) [unique, name: 'uq_brand_category_mappings']
    brand_id [name: 'ix_brand_category_mappings_brand']
  }
}

Table category_monitors {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  brand_id bigint [not null]
  category_url text [not null]
  normalized_url text [not null]
  status varchar(20) [not null, default: 'active', note: 'CHECK: active, paused, disabled']
  last_scanned_at timestamptz
  last_scan_id bigint
  last_scan_status varchar(20) [note: 'CHECK: pending, running, completed, failed']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (brand_id, normalized_url) [unique, name: 'uq_category_monitors_brand_url']
    brand_id [name: 'ix_category_monitors_brand']
    (status, last_scanned_at) [name: 'ix_category_monitors_scheduler']
  }

  Note: 'Exclusao fisica. O indice parcial WHERE status = active pode substituir o indice do scheduler quando o volume justificar.'
}

Table category_scans {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  monitor_id bigint [not null]
  brand_id bigint [not null]
  category_url text [not null]
  origin varchar(20) [not null, note: 'CHECK: manual, scheduled']
  status varchar(20) [not null, default: 'pending', note: 'CHECK: pending, running, completed, failed']
  product_count integer [not null, default: 0, note: 'CHECK >= 0']
  error_message text
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  completed_at timestamptz

  indexes {
    monitor_id [name: 'ix_category_scans_monitor']
    brand_id [name: 'ix_category_scans_brand']
    (monitor_id, started_at) [name: 'ix_category_scans_monitor_time']
    (brand_id, started_at) [name: 'ix_category_scans_brand_time']
  }
}

Table scan_products {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  scan_id bigint [not null]
  scan_product_id uuid [not null]
  source_product_id text
  product_code varchar(160)
  sku_id varchar(160)
  seller_id varchar(160)
  product_url text [not null]
  normalized_url text [not null]
  raw_title text
  raw_description text
  category varchar(200)
  sub_category varchar(200)
  breadcrumb text[] [not null, default: '{}']
  composition text
  collection_ids text[] [not null, default: '{}']
  price_full numeric(12,2) [note: 'CHECK >= 0']
  price_discount numeric(12,2) [note: 'CHECK >= 0']
  price_without_discount numeric(12,2) [note: 'CHECK >= 0']
  effective_price numeric(12,2) [note: 'CHECK >= 0']
  shipping_price numeric(12,2) [note: 'Snapshot do frete usado na captura; CHECK >= 0']
  landed_price numeric(12,2) [note: 'Produto mais frete; CHECK >= 0']
  is_free_shipping boolean [not null, default: false]
  stock_availability boolean
  available_colors text[] [not null, default: '{}']
  available_sizes text[] [not null, default: '{}']
  raw_colors text[] [not null, default: '{}']
  raw_sizes text[] [not null, default: '{}']
  rating numeric(2,1) [note: 'CHECK entre 0 e 5']
  review_count integer [note: 'CHECK >= 0']
  reviews_state varchar(30)
  review_product_id varchar(200)
  specifications jsonb [not null, default: '{}']
  conditional_offers jsonb [not null, default: '[]']
  image_url text
  seller varchar(200)
  captured_at timestamptz [not null, default: `now()`]

  indexes {
    (scan_id, scan_product_id) [unique, name: 'uq_scan_products_scan_product']
    (scan_id, product_code) [unique, name: 'uq_scan_products_scan_code']
    scan_id [name: 'ix_scan_products_scan']
    product_code [name: 'ix_scan_products_code']
    normalized_url [name: 'ix_scan_products_normalized_url']
  }

  Note: 'stock_availability e uma observacao do produto, nao um indicador agregado de ruptura.'
}

Table review_comments {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  scan_product_id bigint [not null]
  source_provider varchar(50) [not null]
  review_id varchar(200) [not null]
  rating numeric(2,1) [note: 'CHECK entre 0 e 5']
  title text
  body text
  author_name varchar(200)
  review_created_at timestamptz
  source_ref text
  captured_at timestamptz [not null, default: `now()`]

  indexes {
    (source_provider, review_id) [unique, name: 'uq_review_comments_provider_review']
    (scan_product_id, review_created_at) [name: 'ix_review_comments_scan_product_time']
  }
}

Table price_monitors {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  job_id uuid [not null, unique]
  brand_id bigint [not null]
  source_key varchar(63) [not null]
  product_url text [not null]
  normalized_url text [not null]
  status varchar(20) [not null, default: 'active', note: 'CHECK: active, paused']
  interval_minutes integer [not null, default: 10, note: 'CHECK > 0']
  duration_hours integer [not null, default: 24, note: 'CHECK > 0']
  started_at timestamptz [not null, default: `now()`]
  last_price numeric(12,2) [note: 'CHECK >= 0']
  last_price_original numeric(12,2) [note: 'CHECK >= 0']
  last_price_discount numeric(12,2) [note: 'CHECK >= 0']
  last_check_state varchar(20) [note: 'CHECK: ok, blocked, error']
  last_error text
  last_checked_at timestamptz
  product_name text
  image_url text
  available_colors text[] [not null, default: '{}']
  available_sizes text[] [not null, default: '{}']
  conditional_offers_current jsonb [not null, default: '[]']
  conditional_offers_status varchar(30)
  conditional_offers_checked_at timestamptz
  conditional_offers_diagnostics jsonb [not null, default: '[]']
  conditional_offer_history jsonb [not null, default: '[]']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (brand_id, source_key, normalized_url) [unique, name: 'uq_price_monitors_brand_source_url']
    brand_id [name: 'ix_price_monitors_brand']
    (status, last_checked_at) [name: 'ix_price_monitors_scheduler']
  }

  Note: 'active e last_status legados sao migrados para status e last_check_state pelo repository.'
}

Table price_history {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  monitor_id bigint [not null]
  price numeric(12,2) [not null, note: 'CHECK >= 0']
  price_original numeric(12,2) [note: 'CHECK >= 0']
  last_price_discount numeric(12,2) [note: 'CHECK >= 0']
  available boolean [not null]
  available_colors text[] [not null, default: '{}']
  available_sizes text[] [not null, default: '{}']
  observed_at timestamptz [not null, default: `now()`]

  indexes {
    monitor_id [name: 'ix_price_history_monitor']
    (monitor_id, observed_at) [name: 'ix_price_history_monitor_time']
  }

  Note: 'Comecar sem particionamento. Avaliar RANGE mensal e BRIN em observed_at quando volume e planos de execucao justificarem.'
}

Table search_jobs {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  job_id uuid [not null, unique]
  query text [not null]
  target_sku text
  search_type varchar(20) [not null, default: 'search', note: 'CHECK: search, cross']
  status varchar(20) [not null, default: 'PENDING', note: 'CHECK: PENDING, RUNNING, COMPLETED, FAILED']
  result_payload jsonb
  error_message text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    created_at [name: 'ix_search_jobs_created_at']
    (status, created_at) [name: 'ix_search_jobs_status_created_at']
  }

  Note: 'Sem GIN inicialmente: a aplicacao recupera o payload completo por job_id.'
}

Table search_job_brands {
  job_id bigint [not null]
  source_key varchar(63) [not null]
  search_order integer

  indexes {
    (job_id, source_key) [pk, name: 'pk_search_job_brands']
    source_key [name: 'ix_search_job_brands_source']
  }
}

Table banner_runs {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  run_id uuid [not null, unique]
  status varchar(20) [not null, default: 'RUNNING', note: 'CHECK: RUNNING, REVIEW, COMPLETED, PARTIAL, CANCELLED, FAILED']
  error_message text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  approved_at timestamptz

  indexes {
    (status, created_at) [name: 'ix_banner_runs_status_created_at']
  }
}

Table banner_run_brands {
  run_id bigint [not null]
  brand_id bigint [not null]
  status varchar(20) [not null, default: 'PENDING', note: 'CHECK: PENDING, RUNNING, COMPLETED, FAILED, CANCELLED']
  banner_count integer [not null, default: 0, note: 'CHECK >= 0']
  video_count integer [not null, default: 0, note: 'CHECK >= 0']
  error_message text

  indexes {
    (run_id, brand_id) [pk, name: 'pk_banner_run_brands']
    brand_id [name: 'ix_banner_run_brands_brand']
  }
}

Table banner_assets {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  sha256 char(64) [not null, unique, note: 'CHECK: exatamente 64 caracteres hexadecimais lowercase']
  object_key text [not null, unique]
  extension varchar(20) [not null]
  content_type varchar(120) [not null]
  byte_count bigint [not null, note: 'CHECK >= 0']
  created_at timestamptz [not null, default: `now()`]
}

Table banner_candidates {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  banner_id uuid [not null, unique]
  run_id bigint [not null]
  brand_id bigint [not null]
  asset_id bigint [not null]
  slide_order integer [not null, note: 'CHECK >= 1']
  friendly_filename text [not null]
  source_url text [not null]
  rendered_url text [not null]
  click_url text
  alt_text text
  dom_kind varchar(30) [not null, default: 'img']
  rendered_width integer
  rendered_height integer
  natural_width integer
  natural_height integer
  approved boolean [not null, default: false]
  captured_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (run_id, brand_id, slide_order) [unique, name: 'uq_banner_candidates_run_brand_slide']
    run_id [name: 'ix_banner_candidates_run']
    brand_id [name: 'ix_banner_candidates_brand']
    asset_id [name: 'ix_banner_candidates_asset']
  }

  Note: 'Recomenda-se indice parcial em run_id e slide_order WHERE approved = true.'
}

Table banner_video_slides {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY']
  run_id bigint [not null]
  brand_id bigint [not null]
  slide_order integer [not null, note: 'CHECK >= 1']
  source_url text

  indexes {
    (run_id, brand_id, slide_order) [unique, name: 'uq_banner_video_slides_run_brand_slide']
    run_id [name: 'ix_banner_video_slides_run']
    brand_id [name: 'ix_banner_video_slides_brand']
  }
}

Ref fk_brand_category_mappings_brand {
  brand_category_mappings.brand_id > brands.id [delete: restrict]
}

Ref fk_category_monitors_brand {
  category_monitors.brand_id > brands.id [delete: restrict]
}

Ref fk_category_monitors_last_scan {
  category_monitors.last_scan_id > category_scans.id [delete: set null]
}

Ref fk_category_scans_monitor {
  category_scans.monitor_id > category_monitors.id [delete: cascade]
}

Ref fk_category_scans_brand {
  category_scans.brand_id > brands.id [delete: restrict]
}

Ref fk_scan_products_scan {
  scan_products.scan_id > category_scans.id [delete: cascade]
}

Ref fk_review_comments_scan_product {
  review_comments.scan_product_id > scan_products.id [delete: cascade]
}

Ref fk_price_monitors_brand {
  price_monitors.brand_id > brands.id [delete: restrict]
}

Ref fk_price_history_monitor {
  price_history.monitor_id > price_monitors.id [delete: cascade]
}

Ref fk_search_job_brands_job {
  search_job_brands.job_id > search_jobs.id [delete: cascade]
}

Ref fk_banner_run_brands_run {
  banner_run_brands.run_id > banner_runs.id [delete: cascade]
}

Ref fk_banner_run_brands_brand {
  banner_run_brands.brand_id > brands.id [delete: restrict]
}

Ref fk_banner_candidates_run {
  banner_candidates.run_id > banner_runs.id [delete: cascade]
}

Ref fk_banner_candidates_brand {
  banner_candidates.brand_id > brands.id [delete: restrict]
}

Ref fk_banner_candidates_asset {
  banner_candidates.asset_id > banner_assets.id [delete: restrict]
}

Ref fk_banner_video_slides_run {
  banner_video_slides.run_id > banner_runs.id [delete: cascade]
}

Ref fk_banner_video_slides_brand {
  banner_video_slides.brand_id > brands.id [delete: restrict]
}

TableGroup catalogo {
  brands
  brand_category_mappings
}

TableGroup monitoramento_categoria {
  category_monitors
  category_scans
  scan_products
  review_comments
}

TableGroup monitoramento_preco {
  price_monitors
  price_history
}

TableGroup buscas {
  search_jobs
  search_job_brands
}

TableGroup banners {
  banner_runs
  banner_run_brands
  banner_assets
  banner_candidates
  banner_video_slides
}
