# Configurações do OmniPulse RPA API
APP_HOST=127.0.0.1
APP_PORT=8080
INTERNAL_API_KEY=portfolio-dev-key
ENVIRONMENT=development
PLAYWRIGHT_ENABLED=true

# Cache de Descoberta de Categorias (em RAM / Postgres)
CATEGORY_DISCOVERY_CACHE_TTL_SECONDS=21600

# Conexão PostgreSQL (Docker ou Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/scrapper_dev?schema=scraping&connection_limit=5&pool_timeout=10"

# RabbitMQ (Worker assíncrono de Categorias e Scans)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=category_scans
RABBITMQ_DLX=category_scans.dlx
RABBITMQ_DLQ=category_scans.dlq
CATEGORY_BIWEEKLY_INTERVAL_DAYS=15

# Autenticação (False permite uso direto no portfólio)
AUTH_ENABLED=false

# Observabilidade (Opcional - OpenTelemetry)
OBS_ENABLED=false
